# ==================================================
# EduGuard AI - Environment Configuration Example
# Copy this file to .env and configure your values.
# ==================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/eduguard_ai
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/eduguard_ai?retryWrites=true&w=majority

# Authentication Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Machine Learning Service (FastAPI)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_SECRET=eduguard_internal_ml_service_token_2026

# Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:5000/api
